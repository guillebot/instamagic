APP_PASSWORD=
APP_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://instamagic:change-me@127.0.0.1:5432/instamagic
REDIS_URL=redis://127.0.0.1:6379/0
DERIVATIVES_ROOT=./data/derivatives
ALLOWED_LIBRARY_ROOTS=
SUGGESTED_LIBRARY_ROOT=
# Host folder bind-mounted to /data/originals in Compose. Must exist before `compose up`.
# Stage uses /fotosarte (see deploy/stage.env.example + APP_UID/APP_GID).
ORIGINALS_ROOT=./fixtures/library
# Stage only: UID:GID for migrate/API/workers so they can read a 770 library
# without chmod'ing the archive. Defaults in docker-compose.stage.yml are 1000:100.
# APP_UID=1000
# APP_GID=100
# Set true in Compose so API/workers refuse to start or scan if /data/originals is not a real mount.
REQUIRE_EXTERNAL_LIBRARY_MOUNTS=false
GEMINI_API_KEY=
GEMINI_IMAGE_POLICY=text_only
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROVIDER=google
SAFETY_CLASSIFIER=onnx
SAFETY_MODEL_PATH=
SAFETY_MODEL_SHA256=c15d8273adad2d0a92f014cc69ab2d6c311a06777a55545f2c4eb46f51911f0f
PIPELINE_MODE=queue
BIND_HOST=127.0.0.1
ALLOW_CONTAINER_BIND=false
AUTO_PUBLISH=false
ENVIRONMENT=local
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional override. When unset, Secure cookies follow FRONTEND_ORIGIN (https → true).
# COOKIE_SECURE=
LOG_LEVEL=INFO
