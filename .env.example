# Optional local override; CI images bake APP_VERSION=YYYYMMDD-XX at build time.
# APP_VERSION=dev
APP_PASSWORD=
APP_SECRET=
# Sessions: 30 days, renewed on activity. Keep APP_SECRET stable or every browser is logged out.
# SESSION_TTL_SECONDS=2592000
# Trusted-IP auto-login for LAN devices (private CIDRs, /24 or narrower). Applies only on the
# FRONTEND_ORIGIN host (override with TRUSTED_LOGIN_HOSTS); never on the public assets host.
# TRUSTED_LOGIN_IPS=10.1.1.150
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://instamagic:change-me@127.0.0.1:5432/instamagic
REDIS_URL=redis://127.0.0.1:6379/0
DERIVATIVES_ROOT=./data/derivatives
ALLOWED_LIBRARY_ROOTS=
SUGGESTED_LIBRARY_ROOT=
# Host folder bind-mounted to /data/originals in Compose. Must exist before `compose up`.
# Stage uses /fotosarte (see deploy/stage.env.example + APP_UID/APP_GID).
ORIGINALS_ROOT=./fixtures/library
# Stage only: UID:GID for migrate/API/workers so they can read a 770 library
# without chmod'ing the archive. Defaults in docker-compose.stage.yml are 1000:100.
# APP_UID=1000
# APP_GID=100
# Set true in Compose so API/workers refuse to start or scan if /data/originals is not a real mount.
REQUIRE_EXTERNAL_LIBRARY_MOUNTS=false
GEMINI_API_KEY=
# preview = Curate/captions may attach EXIF-stripped preview/thumb bytes for Safe/Publishable
# (UI toggle per run). text_only = metadata only (opt-out). manual_only = block Gemini batch.
GEMINI_IMAGE_POLICY=preview
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROVIDER=google
# Optional voice line injected into caption / comment draft prompts.
# ACCOUNT_VOICE=Quiet, craft-first photography captions.
# Instagram Graph (Business/Creator linked to a Facebook Page). Never commit real tokens.
# Prefer saving the token in-app (encrypted in Postgres) via /instagram.
# Env tokens still work and override the database when both are set.
INSTAGRAM_PROVIDER=graph
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v25.0
# When multiple Pages link to IG accounts, prefer this handle (without @), e.g. foto.sch
# INSTAGRAM_EXPECTED_USERNAME=foto.sch
# Meta OAuth — prefer paste App ID/Secret on /instagram (sealed in DB; no restart).
# Optional host fallback (DB wins when both set). Redirect defaults to
# {FRONTEND_ORIGIN}/api/instagram/oauth/callback (not PUBLIC_BASE_URL).
# META_APP_ID=
# META_APP_SECRET=
# Facebook Login for Business configuration id (uses config_id instead of scope when set).
# META_OAUTH_CONFIG_ID=
# META_OAUTH_REDIRECT_URI=

# Required for real publish on stage/production: public https origin serving only
# /api/public/publish-assets/ (e.g. Cloudflare Tunnel). Not the LAN-only Traefik UI host.
PUBLIC_BASE_URL=
SAFETY_CLASSIFIER=onnx
SAFETY_MODEL_PATH=
SAFETY_MODEL_SHA256=c15d8273adad2d0a92f014cc69ab2d6c311a06777a55545f2c4eb46f51911f0f
PIPELINE_MODE=queue
BIND_HOST=127.0.0.1
ALLOW_CONTAINER_BIND=false
# Keep false. To enable (not recommended): AUTO_PUBLISH=true and
# AUTO_PUBLISH_ACK=I_UNDERSTAND_AUTO_PUBLISH_RISKS — Phase 2 still expects human Publish clicks.
AUTO_PUBLISH=false
# AUTO_PUBLISH_ACK=
ENVIRONMENT=local
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional override. When unset, Secure cookies follow FRONTEND_ORIGIN (https → true).
# COOKIE_SECURE=
LOG_LEVEL=INFO
