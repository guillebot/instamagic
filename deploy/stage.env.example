# Stage (.env on 10.1.1.8 under /opt/docker/instamagic). Generate secrets on the host:
#   openssl rand -hex 16   # APP_PASSWORD (12+)
#   openssl rand -hex 32   # APP_SECRET (16+)
#   openssl rand -hex 24   # POSTGRES_PASSWORD
# Never reuse local Mac .env values. Do not commit .env.
#
# Images are pulled (not built). Match CI / Docker Hub / GHCR:
#   IMAGE_PREFIX = Docker Hub user, or ghcr.io/<owner> for GHCR-only
#   IMAGE_TAG    = YYYYMMDD-XX build id (preferred), or sha-<short> / latest
# Calendar day for YYYYMMDD is America/Argentina/Buenos_Aires (see docs/operations.md).

# Match GitHub Actions var DOCKERHUB_USERNAME (org uses gschimmel for Hub).
# Last successful stage deploy used GHCR when Hub token was missing:
#   IMAGE_PREFIX=ghcr.io/guillebot
IMAGE_PREFIX=gschimmel
IMAGE_TAG=latest

APP_PASSWORD=
APP_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://instamagic:change-me@postgres:5432/instamagic
REDIS_URL=redis://redis:6379/0
DERIVATIVES_ROOT=/data/derivatives
ALLOWED_LIBRARY_ROOTS=/data/originals
SUGGESTED_LIBRARY_ROOT=/data/originals
# Host photo archive (mode 770 guille:users). Mounted read-only at /data/originals.
# Do not chmod/chown this tree for Docker — run API/workers as APP_UID:APP_GID instead.
ORIGINALS_ROOT=/fotosarte
# UID:GID for backend + workers (compose user:). Match library owner; nested
# folders may be 711 so group-only cannot list. migrate keeps image default.
APP_UID=1000
APP_GID=100
REQUIRE_EXTERNAL_LIBRARY_MOUNTS=true
GEMINI_API_KEY=
# preview = Curate may send derivative JPEGs (toggle on Curate page). text_only opts out.
GEMINI_IMAGE_POLICY=preview
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROVIDER=google
# Instagram Graph — prefer Meta OAuth on /instagram (sealed in Postgres).
# Optional paste or host INSTAGRAM_* still work; env overrides DB when both are set. Never commit tokens.
INSTAGRAM_PROVIDER=graph
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v21.0
# Meta OAuth (Facebook Login). Prefer paste App ID/Secret on /instagram (sealed in DB).
# Optional host fallback (DB wins when both set):
# META_APP_ID=
# META_APP_SECRET=
# Valid OAuth Redirect URI in Meta Developer Console (exact):
#   https://instamagic.schimmel.homes/api/instagram/oauth/callback
# Permissions: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
# Optional override (defaults to {FRONTEND_ORIGIN}/api/instagram/oauth/callback):
# META_OAUTH_REDIRECT_URI=https://instamagic.schimmel.homes/api/instagram/oauth/callback

# Meta cannot reach LAN-only Traefik. For real publish set a public https base
# that can serve /api/public/publish-assets/{token} (tunnel or CDN), or skip publish on stage.
PUBLIC_BASE_URL=
# Stage refuses SAFETY_CLASSIFIER=fake. Place models/320n.onnx on the host (not in image).
SAFETY_CLASSIFIER=onnx
SAFETY_MODEL_PATH=/models/320n.onnx
SAFETY_MODEL_SHA256=c15d8273adad2d0a92f014cc69ab2d6c311a06777a55545f2c4eb46f51911f0f
PIPELINE_MODE=queue
BIND_HOST=127.0.0.1
ALLOW_CONTAINER_BIND=false
AUTO_PUBLISH=false
ENVIRONMENT=stage
FRONTEND_ORIGIN=https://instamagic.schimmel.homes
LOG_LEVEL=INFO
